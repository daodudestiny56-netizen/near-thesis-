# Optional. Anonymous access works but is rate limited to roughly 1 request/second, which makes
# `python -m census collect` take a couple of hours. A free key from https://dashboard.fastnear.com
# raises the limit; collection then defaults to 8 requests/second.
FASTNEAR_API_KEY=

# Optional overrides
# CENSUS_RPS=1.1
# CENSUS_CACHE=data/cache/http.sqlite
